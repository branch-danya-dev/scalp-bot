# Stage 27 controlled ten-hour research run.
# Loaded after .env.example. Trading semantics/risk thresholds are intentionally
# unchanged; only run duration and long-run recording policy are overridden.
SCALP_RUN_LABEL=research-stage27-latency-strategy-audit-10h
SCALP_PAPER_RUN_DURATION_SECONDS=36000

# Keep semantic/market context at useful resolution without duplicating the
# same trade tape in every frame.
SCALP_RESEARCH_FRAME_SECONDS=3
SCALP_RESEARCH_TRADE_DELTA_ENABLED=true
# In delta mode this acts only as the legacy rolling fallback and is not used
# to truncate new prints between frames.
SCALP_RESEARCH_RECENT_TRADES=250

# Replay/UI frames stay lightweight. Exact trade tape is preserved by the
# research_frame stream, so market_frame does not need a second copy.
SCALP_REPLAY_ENGAGED_FRAME_SECONDS=5
SCALP_REPLAY_IDLE_FRAME_SECONDS=20
SCALP_REPLAY_RECENT_TRADES=0
SCALP_REPLAY_TRADE_DELTA_ENABLED=false

# Long-run semantic telemetry remains compact.
SCALP_MARKET_CONTEXT_EVENT_INTERVAL_SECONDS=10

# Prometheus endpoint remains available. OpenTelemetry export is optional and
# kept off in the core 10h profile so the run has no external collector
# dependency; use the observability stack separately when full traces are
# desired.
SCALP_PROMETHEUS_ENABLED=true
SCALP_OTEL_ENABLED=false
