# Ten-hour fee/frequency research profile.
# Loaded after .env.example. Trading logic is unchanged; only run identity,
# duration, and recorder cadence/duplication are adjusted for a long session.
SCALP_RUN_LABEL=research-fee-frequency-v7-10h
SCALP_PAPER_RUN_DURATION_SECONDS=36000

# Long-run observability: keep enough temporal detail for post-run analysis
# without producing tens of gigabytes of duplicated frames.
SCALP_RESEARCH_FRAME_SECONDS=3
SCALP_REPLAY_ENGAGED_FRAME_SECONDS=3
SCALP_REPLAY_IDLE_FRAME_SECONDS=15
SCALP_RESEARCH_RECENT_TRADES=80
SCALP_REPLAY_RECENT_TRADES=80
