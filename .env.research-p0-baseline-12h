# P0 observational baseline: data quality and unchanged strategy diagnostics.
# Loaded after .env.example; not a validation of profitability or replay parity.
SCALP_DISABLE_DOTENV=1
SCALP_RUN_LABEL=research-p0-baseline-v1-12h
SCALP_PAPER_RUN_DURATION_SECONDS=43200
SCALP_SESSION_DIR=data/sessions

# Fixed strategy set. Do not toggle strategies during this run in the UI.
SCALP_TREND_STRUCTURE_ENABLED=false
SCALP_WEAK_LEVEL_REJECTION_ENABLED=true
SCALP_BREAKOUT_ENABLED=true
SCALP_DENSITY_ENABLED=true
SCALP_BREAKOUT_STAGED_ENTRIES_ENABLED=false
SCALP_WEAK_LEVEL_REJECTION_STAGED_ENTRIES_ENABLED=false
SCALP_RESEARCH_POLICY_MODE=off
SCALP_RESEARCH_POLICY_FILE=

# Deterministic paper fee assumptions, independent of optional account credentials.
SCALP_FEE_RATE_MODE=configured
SCALP_TAKER_FEE_RATE=0.00055
SCALP_MAKER_FEE_RATE=0.00020
SCALP_SLIPPAGE_BPS=1.0

# Preserve the full received trade delta between research snapshots.
SCALP_RESEARCH_FRAME_SECONDS=3
SCALP_RESEARCH_TRADE_DELTA_ENABLED=true
SCALP_RESEARCH_RECENT_TRADES=250
SCALP_REPLAY_ENGAGED_FRAME_SECONDS=5
SCALP_REPLAY_IDLE_FRAME_SECONDS=20
SCALP_REPLAY_RECENT_TRADES=0
SCALP_REPLAY_TRADE_DELTA_ENABLED=false
SCALP_MARKET_CONTEXT_EVENT_INTERVAL_SECONDS=10
SCALP_PROMETHEUS_ENABLED=true
SCALP_OTEL_ENABLED=false
