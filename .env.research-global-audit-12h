# Exact 12-hour Stage 19 global audit profile.
# Prepared only. Do not run until the Stage 19 code audit and short smoke are
# explicitly approved.
SCALP_RUN_LABEL=research-stage19-global-audit-12h
SCALP_PAPER_RUN_DURATION_SECONDS=43200

# Tradeable playbooks. Trend continuation remains disabled until it proves
# forward edge; density remains enabled only as liquidity evidence.
SCALP_TREND_STRUCTURE_ENABLED=false
SCALP_WEAK_LEVEL_REJECTION_ENABLED=true
SCALP_DENSITY_ENABLED=true
SCALP_BREAKOUT_ENABLED=true

# Scale-in infrastructure is retained but disabled for current playbooks.
SCALP_STAGED_ENTRIES_ENABLED=true
SCALP_BREAKOUT_STAGED_ENTRIES_ENABLED=false
SCALP_WEAK_LEVEL_REJECTION_STAGED_ENTRIES_ENABLED=false

# Structural / portfolio risk.
SCALP_RISK_FRACTION=0.005
SCALP_MAX_TRADE_ALL_IN_LOSS_FRACTION=0.0125
SCALP_MAX_TOTAL_RISK_FRACTION=0.02
SCALP_MAX_POSITION_LEVERAGE=5.0
SCALP_MAX_LEVERAGE=10.0

# Hard economics. The 1.15 gate remains observable/shadow; 1.0 net R:R is
# non-disableable in RiskEngine.
SCALP_ABSOLUTE_MIN_NET_REWARD_RISK=1.0
SCALP_MIN_NET_REWARD_RISK=1.15
SCALP_ENFORCE_NET_REWARD_RISK_GATE=false
SCALP_MIN_NET_PROFIT_USD=1.0
SCALP_MIN_NET_PROFIT_EQUITY_FRACTION=0.001
SCALP_ENFORCE_MIN_NET_PROFIT_GATE=true
SCALP_MAX_WINNER_COST_SHARE=0.35
SCALP_ENFORCE_WINNER_COST_SHARE_GATE=true
SCALP_MAX_STOP_COST_SHARE=1.0
SCALP_ENFORCE_STOP_COST_SHARE_GATE=true
SCALP_MIN_FIRST_TAKE_MOVE_PCT=0.001
SCALP_ENFORCE_MIN_FIRST_TAKE_MOVE_GATE=true
SCALP_ENFORCE_STRATEGY_EXPECTANCY_GATE=false
SCALP_ENFORCE_SESSION_LOSS_LIMIT=false

# Stage 19 strategy lifecycle.
SCALP_WEAK_LEVEL_REJECTION_PARTIAL_TAKE_FRACTION=0.30
SCALP_BREAKOUT_PARTIAL_TAKE_FRACTION=0.30
SCALP_BREAKOUT_RETEST_TOLERANCE_BPS=3.0
SCALP_BREAKOUT_HOLD_WITHOUT_RETEST_SECONDS=8.0
SCALP_BREAKOUT_ABSORPTION_EFFICIENCY_THRESHOLD=0.35
SCALP_BREAKOUT_MIN_DIRECTIONAL_RESPONSE_BPS=5.0

# Fast decision path and compact context telemetry.
SCALP_EVALUATION_IDLE_INTERVAL_SECONDS=0.8
SCALP_EVALUATION_ENGAGED_INTERVAL_SECONDS=0.20
SCALP_MARKET_CONTEXT_EVENT_INTERVAL_SECONDS=10

# 3s research frames retain enough causal context for the global audit without
# recreating the multi-GB market_context_changed churn from Stage 17.
SCALP_RESEARCH_FRAME_SECONDS=3
SCALP_REPLAY_ENGAGED_FRAME_SECONDS=3
SCALP_REPLAY_IDLE_FRAME_SECONDS=15
SCALP_RESEARCH_RECENT_TRADES=80
SCALP_REPLAY_RECENT_TRADES=80
