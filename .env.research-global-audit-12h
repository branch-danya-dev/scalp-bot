# Exact 12-hour global audit profile.
# Run only after the Stage 17 smoke session passes technical validation.
SCALP_RUN_LABEL=research-stage17-global-audit-12h
SCALP_PAPER_RUN_DURATION_SECONDS=43200

SCALP_TREND_STRUCTURE_ENABLED=true
SCALP_WEAK_LEVEL_REJECTION_ENABLED=true
SCALP_DENSITY_ENABLED=true
SCALP_BREAKOUT_ENABLED=true

SCALP_STAGED_ENTRIES_ENABLED=true
SCALP_BREAKOUT_PROBE_RISK_FRACTION=0.35
SCALP_WEAK_LEVEL_REJECTION_PROBE_RISK_FRACTION=0.30

# Keep economics comparable with the analyzed two-hour run.
SCALP_MIN_FIRST_TAKE_MOVE_PCT=0.001
SCALP_ENFORCE_MIN_FIRST_TAKE_MOVE_GATE=true

SCALP_ENFORCE_WINNER_COST_SHARE_GATE=false
SCALP_ENFORCE_STOP_COST_SHARE_GATE=false
SCALP_ENFORCE_MIN_NET_PROFIT_GATE=false
SCALP_ENFORCE_NET_REWARD_RISK_GATE=false
SCALP_ENFORCE_STRATEGY_EXPECTANCY_GATE=false
SCALP_ENFORCE_SESSION_LOSS_LIMIT=false

SCALP_EVALUATION_IDLE_INTERVAL_SECONDS=0.8
SCALP_EVALUATION_ENGAGED_INTERVAL_SECONDS=0.20

# State transitions and decision events keep sub-second causal snapshots.
# 3s frames keep the 12h raw dataset manageable while preserving context.
SCALP_RESEARCH_FRAME_SECONDS=3
SCALP_REPLAY_ENGAGED_FRAME_SECONDS=3
SCALP_REPLAY_IDLE_FRAME_SECONDS=15
SCALP_RESEARCH_RECENT_TRADES=80
SCALP_REPLAY_RECENT_TRADES=80
