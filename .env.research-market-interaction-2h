# Two-hour observational run for Market Interaction Research.
# Trading rules intentionally match the previous movement-floor run so the
# new analyzer measures behavior without changing the treatment.
SCALP_RUN_LABEL=research-market-interaction-v1-2h
SCALP_PAPER_RUN_DURATION_SECONDS=7200

SCALP_TREND_STRUCTURE_ENABLED=true
SCALP_WEAK_LEVEL_REJECTION_ENABLED=true
SCALP_DENSITY_ENABLED=true
SCALP_BREAKOUT_ENABLED=true

SCALP_MIN_FIRST_TAKE_MOVE_PCT=0.001
SCALP_ENFORCE_MIN_FIRST_TAKE_MOVE_GATE=true

SCALP_ENFORCE_WINNER_COST_SHARE_GATE=false
SCALP_ENFORCE_STOP_COST_SHARE_GATE=false
SCALP_ENFORCE_MIN_NET_PROFIT_GATE=false
SCALP_ENFORCE_NET_REWARD_RISK_GATE=false
SCALP_ENFORCE_STRATEGY_EXPECTANCY_GATE=false

SCALP_RESEARCH_FRAME_SECONDS=3
SCALP_REPLAY_ENGAGED_FRAME_SECONDS=3
SCALP_REPLAY_IDLE_FRAME_SECONDS=15
SCALP_RESEARCH_RECENT_TRADES=80
SCALP_REPLAY_RECENT_TRADES=80
