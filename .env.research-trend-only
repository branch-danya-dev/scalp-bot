# Isolated trend_structure research profile.
# Only the trend pullback strategy is enabled. Use this after the 1m candle
# integrity fix so every signal can be reviewed without cross-strategy noise.
SCALP_RUN_LABEL=research-trend-structure-v1-4h
SCALP_PAPER_RUN_DURATION_SECONDS=14400

SCALP_TREND_STRUCTURE_ENABLED=true
SCALP_WEAK_LEVEL_REJECTION_ENABLED=false
SCALP_DENSITY_ENABLED=false
SCALP_BREAKOUT_ENABLED=false

# Preserve detailed diagnostics for the single strategy without the 10h
# multi-strategy file-size explosion.
SCALP_RESEARCH_FRAME_SECONDS=2
SCALP_REPLAY_ENGAGED_FRAME_SECONDS=2
SCALP_REPLAY_IDLE_FRAME_SECONDS=10
SCALP_RESEARCH_RECENT_TRADES=120
SCALP_REPLAY_RECENT_TRADES=120

# In the isolated strategy lab economics is observational: a confirmed trend
# setup must reach paper execution so we can measure the strategy itself.
SCALP_ENFORCE_WINNER_COST_SHARE_GATE=false
SCALP_ENFORCE_MIN_NET_PROFIT_GATE=false
SCALP_ENFORCE_NET_REWARD_RISK_GATE=false
